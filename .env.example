# ============================================================================
# Wellspire SMS — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` for local development, and set the same keys in
# Render (Dashboard → your service → Environment) and Supabase for production.
#
# ⚠️  NEVER commit a real .env file. Everything here is read at runtime only.
# ============================================================================

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Public URL of the deployed app (used by OpenRouter referer + email links)
APP_URL=http://localhost:8080

# --- Supabase (Postgres) --------------------------------------------------
# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon (public) key is safe to expose to the browser
SUPABASE_ANON_KEY=your-anon-key
# The service_role key is SECRET — server-side only, bypasses RLS. NEVER ship to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenRouter (AI) ------------------------------------------------------
# From https://openrouter.ai/keys  — set this in Render env vars, not in code.
# ⚠️ If a key was ever shared in chat/plaintext, ROTATE it before using.
# Format looks like: sk-or-v1-<64 hex chars>. Leave blank here; set the real
# value only in Render/Supabase environment variables.
OPENROUTER_API_KEY=
# Default model for AI features (timetable, reminder copy, assistant)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Notifications (optional — reminders still record in-app without these) -
# Email via SMTP (e.g. Resend, SendGrid, Gmail SMTP). Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Wellspire School <no-reply@wellspire.school>"

# --- Automations (cron) ---------------------------------------------------
# Master switch for scheduled jobs (fee reminders, teacher reminders)
ENABLE_AUTOMATIONS=true
# Timezone for all schedules (IANA name)
SCHOOL_TIMEZONE=Asia/Kolkata
# Send fee reminders when an invoice is due within N days, or overdue
FEE_REMINDER_DAYS_BEFORE=7
# Cron expressions (server local time = SCHOOL_TIMEZONE)
CRON_FEE_REMINDERS=0 9 * * *
CRON_TEACHER_REMINDERS=0 7 * * 1-6

# --- Frontend build-time vars (Vite) --------------------------------------
# These are injected into the browser bundle — only PUBLIC values here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE=/api
